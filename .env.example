# Copy to .env (git-ignored) and fill in. Never commit or share keys.

# Hosted models: any OpenAI-compatible router (docs/ISSUES.md I1)
# Otari keys are region-bound: use the host the key belongs to (e.g. eu.api.otari.ai)
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
OTARI_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_API_KEY=

# Fingrid open data API key (free): https://data.fingrid.fi
FINGRID_API_KEY=
# ENTSO-E transparency platform token (optional, for publishable day-ahead prices, ISSUES I24)
ENTSOE_TOKEN=

# Harvard Dataverse guestbook for the Milan data (sent once per file download)
DATAVERSE_GB_NAME=
DATAVERSE_GB_EMAIL=
DATAVERSE_GB_INSTITUTION=
DATAVERSE_GB_POSITION=
